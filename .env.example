# Clicky for Windows — environment configuration
# Copy this to .env and fill in your API keys.

# Claude API (required — either direct key or worker URL)
ANTHROPIC_API_KEY=
# CLICKY_WORKER_URL=https://your-worker.workers.dev

# ElevenLabs TTS (optional — if not set, TTS is silently skipped)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# AssemblyAI Speech-to-Text (required for voice input)
ASSEMBLYAI_API_KEY=
